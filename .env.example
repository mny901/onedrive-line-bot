# .env.example — このファイルを .env にコピーして値を入れてください（.env は Git に含めません）

# Microsoft Graph（OneDrive）: Azure ポータルの「アプリの登録」で作ったアプリのクライアント ID
CLIENT_ID=
# 個人の Microsoft アカウントなら consumers のままで OK
TENANT_ID=consumers
SCOPES=Files.Read
GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0

# LINE Messaging API: チャネルアクセストークン（長期）と、送信先のグループ ID
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=

# gemini_text_test.py だけで使用（Google AI Studio の API キー）
GEMINI_API_KEY=
